# ============================================================================
# RISA-ERP — Production Environment (Hostinger Shared Hosting)
# ============================================================================
# Copy file ini ke `.env` DI SERVER (jangan commit .env!):
#   cp .env.production.example .env
#   nano .env    # isi placeholder <...>
#   php artisan key:generate --force
# ============================================================================

APP_NAME="RISA OrthoERP"
APP_ENV=production
APP_KEY=                                          # WAJIB kosong dulu — generate via `php artisan key:generate`
APP_DEBUG=false                                   # WAJIB false di production!
APP_URL=https://erp.<namadomain>.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ---------------------------------------------------------------------------
# Database (Hostinger MySQL — dapat dari hPanel → Databases)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost                                 # atau IP dari hPanel
DB_PORT=3306
DB_DATABASE=<uXXXXXX_risaerp>
DB_USERNAME=<uXXXXXX_admin>
DB_PASSWORD=<GENERATE_STRONG_PASSWORD>

# Secondary DB (company profile / website) — kosongkan kalau belum dipakai
# DB_COMPANY_HOST=localhost
# DB_COMPANY_DATABASE=<uXXXXXX_risa_app>
# DB_COMPANY_USERNAME=<uXXXXXX_app>
# DB_COMPANY_PASSWORD=<...>

# ---------------------------------------------------------------------------
# Session / Cache / Queue — semua database (shared hosting no Redis)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=risa_erp_

QUEUE_CONNECTION=sync                             # atau `database` + cron worker
                                                  # (default: sync — job jalan real-time di request)

# ---------------------------------------------------------------------------
# Filesystem — biarkan local, jangan S3 (shared hosting)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Logging — daily rotation, warning ke atas
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning                                 # production: warning/error saja
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Broadcasting — matikan (butuh service terpisah)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=null

# ---------------------------------------------------------------------------
# Mail (Hostinger SMTP — cek dari hPanel → Emails)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@<namadomain>.co.id
MAIL_PASSWORD=<mail-password>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@<namadomain>.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Trusted proxies (kalau di belakang Cloudflare / Hostinger LB)
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# Vite (production — assets sudah di-build via npm run build)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Runtime maintenance
# ---------------------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12                                  # production: 12 (bukan 4 seperti testing)
